# ── Ah Gong GPS environment ──────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit `.env`.

# ── MERaLiON (speech-to-text) ────────────────────────────────────────────────
# Register: POST https://api.meralion.ai/keys/register
#       or: https://meralion.org/api-console  → "My Key" tab
# Check your tier afterwards: GET https://api.meralion.ai/v1/rate-limit/status
MERALION_API_KEY=
MERALION_BASE_URL=https://api.meralion.ai
MERALION_MODEL=MERaLiON/MERaLiON-3-3B-ASR-CTM

# ── OneMap (search / routing / reverse-geocode / themes) ─────────────────────
# Register: https://www.onemap.gov.sg/apidocs/register
#
# Two ways in, and the server accepts either:
#
#  (a) ONEMAP_TOKEN — a raw token from the portal. Valid exactly 72 hours.
#      Fastest to get started; NO auto-refresh, so it WILL die mid-hackathon if
#      the event runs past its expiry. Check `exp` by decoding the JWT payload.
#
#  (b) ONEMAP_EMAIL + ONEMAP_PASSWORD — preferred. Lets the server mint and
#      refresh its own token on 401, so expiry stops being a demo-day risk.
#
# Send the token as `Authorization: <token>` — NO "Bearer " prefix.
ONEMAP_TOKEN=
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# ── Gemini (destination extraction + instruction rewrite) ────────────────────
# Free tier. Register a key: https://aistudio.google.com/apikey
# Then check your REAL rate limits (Google won't publish fixed numbers — they
# vary by account tier): https://aistudio.google.com/rate-limit
# Models used: gemini-2.5-flash-lite (extraction), gemini-2.5-flash (rewrite)
# — both confirmed free-tier-eligible on ai.google.dev/gemini-api/docs/pricing.
GEMINI_API_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
API_PORT=8787

# DEMO_MODE=1 swaps EVERY provider for its Fixture* implementation.
# Zero network calls. This is the on-stage kill switch — rehearse with it.
DEMO_MODE=0
